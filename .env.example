# Copy to .env.local for local overrides. Never commit real secrets.
# Base path for the GitHub Pages project site ("/" for a custom domain)
VITE_BASE_PATH=/wp-putki-demo/
# Public URL used for canonical/OG links and the sitemap
SITE_URL=https://samijturunen01.github.io/wp-putki-demo/
# "demo" = mock submission (no data leaves the browser). "apps-script" = future production adapter.
VITE_FORM_MODE=demo
# Future production only: Google Apps Script web app URL (public endpoint, not a secret)
VITE_FORM_ENDPOINT=
# Future production only: reCAPTCHA v3 SITE key (public). The SECRET key belongs only in Apps Script.
VITE_RECAPTCHA_SITE_KEY=
# Keep false for the demo. Set true only after the customer approves production indexing.
VITE_ALLOW_INDEXING=false
